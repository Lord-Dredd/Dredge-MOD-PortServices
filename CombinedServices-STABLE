        // =========================================================
        // RESET
        // =========================================================

        public void ResetForNextDock()
        {
            StopSpeedEffects();

            if (routeWatcherCoroutine !=
                null)
            {
                StopCoroutine(
                    routeWatcherCoroutine
                );

                routeWatcherCoroutine =
                    null;
            }

            menuOpen =
                false;

            modRouteActive =
                false;

            setupRunning =
                false;

            LauncherButton =
                null;

            currentDock =
                null;

            currentDockUI =
                null;

            serviceEntries.Clear();

            peopleEntries.Clear();

            setupCoroutine =
                null;

            forgePosition =
                0;

            showForgeMessage =
                false;
        }

