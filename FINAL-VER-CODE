        private void PlayVanillaUISound(
            bool openingSound)
        {
            // Stops two callbacks in the same frame from stacking
            // the same short vanilla UI sound.
            if (Time.unscaledTime -
                    lastVanillaUISoundTime <
                0.04f)
            {
                return;
            }

            try
            {
                Component source =
                    GetVanillaUISoundButton();

                if (source ==
                    null)
                {
                    return;
                }

                MethodInfo method =
                    AccessTools.Method(
                        source.GetType(),
                        openingSound
                            ? "PlaySelectSFX"
                            : "PlaySubmitSFX"
                    );

                if (method ==
                    null)
                {
                    return;
                }

                method.Invoke(
                    source,
                    null
                );

                lastVanillaUISoundTime =
                    Time.unscaledTime;
            }
            catch (Exception ex)
            {
                if (!vanillaUISoundFailureLogged)
                {
                    vanillaUISoundFailureLogged =
                        true;

                    Main.Log(
                        $"Vanilla UI sound lookup failed: {ex.Message}"
                    );
                }
            }
        }

        private Component GetVanillaUISoundButton()
        {
            if (vanillaUISoundButton !=
                    null &&
                vanillaUISoundButton.gameObject !=
                    null)
            {
                return vanillaUISoundButton;
            }

            Type wrapperType =
                AccessTools.TypeByName(
                    "BasicButtonWrapper"
                );

            if (wrapperType ==
                null)
            {
                return null;
            }

            if (LauncherButton !=
                null)
            {
                vanillaUISoundButton =
                    LauncherButton.GetComponent(
                        wrapperType
                    );

                if (vanillaUISoundButton !=
                    null)
                {
                    return vanillaUISoundButton;
                }
            }

            UnityEngine.Object[] candidates =
                Resources.FindObjectsOfTypeAll(
                    wrapperType
                );

            foreach (UnityEngine.Object candidate
                     in candidates)
            {
                Component component =
                    candidate as Component;

                if (component ==
                        null ||
                    component.gameObject ==
                        null ||
                    !component.gameObject
                        .activeInHierarchy)
                {
                    continue;
                }

                vanillaUISoundButton =
                    component;

                return vanillaUISoundButton;
            }

            return null;
        }

