        public void OnDockUIShown(
            DockUI dockUI,
            Dock dock)
        {
            if (dockUI ==
                    null ||
                dock ==
                    null)
            {
                return;
            }

            if (!portVisitRecordedForCurrentDock)
            {
                RecordPortVisit(
                    dock
                );

                portVisitRecordedForCurrentDock =
                    true;
            }

            currentDockUI =
                dockUI;

            currentDock =
                dock;

            if (setupCoroutine !=
                null)
            {
                StopCoroutine(
                    setupCoroutine
                );
            }

            setupCoroutine =
                StartCoroutine(
                    SetupDock(
                        dockUI,
                        dock
                    )
                );
        }

        private IEnumerator SetupDock(
            DockUI dockUI,
            Dock dock)
        {
            if (setupRunning)
            {
                yield break;
            }

            setupRunning =
                true;

            yield return
                new WaitForEndOfFrame();

            yield return
                new WaitForEndOfFrame();

            if (!PlayerIsDocked() ||
                GameManager.Instance.Player
                    .CurrentDock !=
                    dock)
            {
                setupRunning =
                    false;

                setupCoroutine =
                    null;

                yield break;
            }

            currentDockUI =
                dockUI;

            currentDock =
                dock;

            CreateOrRefreshLauncher(
                dockUI
            );

            // Only harvest while vanilla dock is live.
            if (DockWindowShowing())
            {
                RefreshEntries();
            }

            setupRunning =
                false;

            setupCoroutine =
                null;
        }

