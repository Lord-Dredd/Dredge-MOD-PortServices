        public void PositionLauncher(
            DestinationButton launcher)
        {
            if (launcher ==
                null)
            {
                return;
            }

            if (!launcherPositionValid ||
                Time.unscaledTime >=
                    nextLauncherPositionCheck)
            {
                cachedLauncherPosition =
                    FindSafeLauncherPosition(
                        launcher
                    );

                launcherPositionValid =
                    true;

                nextLauncherPositionCheck =
                    Time.unscaledTime +
                    LAUNCHER_POSITION_CHECK_INTERVAL;

                // Keep our launcher last in the vanilla destination
                // container so equal-canvas elements draw beneath it.
                try
                {
                    launcher.transform
                        .SetAsLastSibling();
                }
                catch
                {
                }
            }

            launcher.transform.position =
                cachedLauncherPosition;
        }

        private Vector3 FindSafeLauncherPosition(
            DestinationButton launcher)
        {
            Vector3 fallback =
                new Vector3(
                    Screen.width *
                        0.5f,
                    Screen.height *
                        0.34f,
                    0f
                );

            if (currentDockUI ==
                null)
            {
                return fallback;
            }

            try
            {
                List<Rect> occupied =
                    new List<Rect>();

                DestinationButton[]
                    destinationButtons =
                        currentDockUI
                            .GetComponentsInChildren<
                                DestinationButton
                            >(true);

                foreach (DestinationButton button
                         in destinationButtons)
                {
                    if (button ==
                            null ||
                        button ==
                            launcher ||
                        !button.gameObject
                            .activeInHierarchy)
                    {
                        continue;
                    }

                    AddOccupiedButtonRect(
                        button,
                        occupied
                    );
                }

                SubDestinationButton[]
                    subDestinationButtons =
                        currentDockUI
                            .GetComponentsInChildren<
                                SubDestinationButton
                            >(true);

                foreach (SubDestinationButton button
                         in subDestinationButtons)
                {
                    if (button ==
                            null ||
                        !button.gameObject
                            .activeInHierarchy)
                    {
                        continue;
                    }

                    AddOccupiedButtonRect(
                        button,
                        occupied
                    );
                }

                SpeakerButton[] speakerButtons =
                    currentDockUI
                        .GetComponentsInChildren<
                            SpeakerButton
                        >(true);

                foreach (SpeakerButton button
                         in speakerButtons)
                {
                    if (button ==
                            null ||
                        !button.gameObject
                            .activeInHierarchy)
                    {
                        continue;
                    }

                    AddOccupiedButtonRect(
                        button,
                        occupied
                    );
                }

                Rect launcherBounds =
                    GetScreenRect(
                        launcher
                    );

                float launcherWidth =
                    Mathf.Clamp(
                        launcherBounds.width,
                        110f,
                        340f
                    );

                float launcherHeight =
                    Mathf.Clamp(
                        launcherBounds.height,
                        70f,
                        150f
                    );

                Vector2 pivot =
                    new Vector2(
                        0.5f,
                        0.5f
                    );

                RectTransform launcherRectTransform =
                    launcher.transform
                        as RectTransform;

                if (launcherRectTransform !=
                    null)
                {
                    pivot =
                        launcherRectTransform
                            .pivot;
                }

                Vector3 bestPosition =
                    fallback;

                float bestOverlap =
                    float.MaxValue;

                foreach (Vector2 anchor
                         in launcherCandidateAnchors)
                {
                    Vector3 candidatePosition =
                        new Vector3(
                            Screen.width *
                                anchor.x,
                            Screen.height *
                                anchor.y,
                            0f
                        );

                    Rect candidateRect =
                        new Rect(
                            candidatePosition.x -
                                (launcherWidth *
                                pivot.x),
                            candidatePosition.y -
                                (launcherHeight *
                                pivot.y),
                            launcherWidth,
                            launcherHeight
                        );

                    if (candidateRect.xMin <
                            20f ||
                        candidateRect.xMax >
                            Screen.width -
                            20f ||
                        candidateRect.yMin <
                            90f ||
                        candidateRect.yMax >
                            Screen.height -
                            120f)
                    {
                        continue;
                    }

                    float totalOverlap =
                        0f;

                    foreach (Rect occupiedRect
                             in occupied)
                    {
                        float overlapWidth =
                            Mathf.Max(
                                0f,
                                Mathf.Min(
                                    candidateRect.xMax,
                                    occupiedRect.xMax
                                ) -
                                Mathf.Max(
                                    candidateRect.xMin,
                                    occupiedRect.xMin
                                )
                            );

                        float overlapHeight =
                            Mathf.Max(
                                0f,
                                Mathf.Min(
                                    candidateRect.yMax,
                                    occupiedRect.yMax
                                ) -
                                Mathf.Max(
                                    candidateRect.yMin,
                                    occupiedRect.yMin
                                )
                            );

                        totalOverlap +=
                            overlapWidth *
                            overlapHeight;
                    }

                    if (totalOverlap <=
                        0f)
                    {
                        return candidatePosition;
                    }

                    if (totalOverlap <
                        bestOverlap)
                    {
                        bestOverlap =
                            totalOverlap;

                        bestPosition =
                            candidatePosition;
                    }
                }

                return bestPosition;
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Adaptive launcher placement failed: {ex.Message}"
                );

                return fallback;
            }
        }

        private void AddOccupiedButtonRect(
            Component component,
            List<Rect> occupied)
        {
            Rect rect =
                GetScreenRect(
                    component
                );

            const float padding =
                18f;

            occupied.Add(
                new Rect(
                    rect.xMin -
                        padding,
                    rect.yMin -
                        padding,
                    rect.width +
                        (padding *
                        2f),
                    rect.height +
                        (padding *
                        2f)
                )
            );
        }

        private Rect GetScreenRect(
            Component component)
        {
            RectTransform rectTransform =
                component !=
                        null
                    ? component.transform
                        as RectTransform
                    : null;

            if (rectTransform ==
                null)
            {
                Vector3 position =
                    component !=
                            null
                        ? component.transform
                            .position
                        : Vector3.zero;

                return new Rect(
                    position.x -
                        80f,
                    position.y -
                        40f,
                    160f,
                    80f
                );
            }

            Vector3[] corners =
                new Vector3[4];

            rectTransform.GetWorldCorners(
                corners
            );

            float minX =
                corners.Min(
                    corner =>
                        corner.x
                );

            float maxX =
                corners.Max(
                    corner =>
                        corner.x
                );

            float minY =
                corners.Min(
                    corner =>
                        corner.y
                );

            float maxY =
                corners.Max(
                    corner =>
                        corner.y
                );

            float width =
                maxX -
                minX;

            float height =
                maxY -
                minY;

            if (width <
                    1f ||
                height <
                    1f)
            {
                Vector3 position =
                    rectTransform.position;

                return new Rect(
                    position.x -
                        80f,
                    position.y -
                        40f,
                    160f,
                    80f
                );
            }

            return Rect.MinMaxRect(
                minX,
                minY,
                maxX,
                maxY
            );
        }

        private void SelfHealLauncher()
        {
            if (menuOpen ||
                modRouteActive)
            {
                return;
            }

            if (Time.unscaledTime <
                nextLauncherCheck)
            {
                return;
            }

            nextLauncherCheck =
                Time.unscaledTime +
                LAUNCHER_CHECK_INTERVAL;

            if (!PlayerIsDocked())
            {
                return;
            }

            if (currentDockUI ==
                null)
            {
                currentDockUI =
                    GameManager.Instance
                        .UI
                        .DockUI;
            }

            if (!DockWindowShowing() ||
                DialogueShowing())
            {
                return;
            }

            bool missing =
                LauncherButton ==
                    null ||
                LauncherButton.gameObject ==
                    null ||
                !LauncherButton
                    .gameObject
                    .activeInHierarchy;

            if (missing)
            {
                CreateOrRefreshLauncher(
                    currentDockUI
                );
            }
        }

        private void CreateOrRefreshLauncher(
            DockUI dockUI)
        {
            GameObject existing =
                FindExistingLauncher(
                    dockUI
                );

            if (existing !=
                null)
            {
                DestinationButton
                    existingButton =
                        existing.GetComponent<
                            DestinationButton
                        >();

                if (existingButton !=
                    null)
                {
                    LauncherButton =
                        existingButton;

                    launcherPositionValid =
                        false;

                    nextLauncherPositionCheck =
                        0f;

                    SetLauncherText(
                        "Port Services"
                    );

                    ApplyCustomIcon(
                        existingButton
                    );

                    return;
                }
            }

            var prefabField =
                AccessTools.Field(
                    typeof(DockUI),
                    "destinationButtonPrefab"
                );

            var containerField =
                AccessTools.Field(
                    typeof(DockUI),
                    "destinationButtonContainer"
                );

            if (prefabField ==
                    null ||
                containerField ==
                    null)
            {
                return;
            }

            GameObject prefab =
                prefabField.GetValue(
                    dockUI
                )
                as GameObject;

            Transform container =
                containerField.GetValue(
                    dockUI
                )
                as Transform;

            if (prefab ==
                    null ||
                container ==
                    null)
            {
                return;
            }

            GameObject launcherObject =
                UnityEngine.Object.Instantiate(
                    prefab,
                    container
                );

            launcherObject.name =
                "CombinedServices.PortServicesLauncher";

            DestinationButton launcher =
                launcherObject.GetComponent<
                    DestinationButton
                >();

            if (launcher ==
                null)
            {
                UnityEngine.Object.Destroy(
                    launcherObject
                );

                return;
            }

            LauncherButton =
                launcher;

            launcherPositionValid =
                false;

            nextLauncherPositionCheck =
                0f;

            PrepareLauncher(
                launcher
            );

            AddLauncherForCleanup(
                dockUI,
                launcherObject
            );

            SetLauncherText(
                "Port Services"
            );

            ApplyCustomIcon(
                launcher
            );
        }

        private GameObject FindExistingLauncher(
            DockUI dockUI)
        {
            var field =
                AccessTools.Field(
                    typeof(DockUI),
                    "destinationButtonObjects"
                );

            if (field ==
                null)
            {
                return null;
            }

            List<GameObject> objects =
                field.GetValue(
                    dockUI
                )
                as List<GameObject>;

            if (objects ==
                null)
            {
                return null;
            }

            foreach (
                GameObject obj
                in objects)
            {
                if (obj ==
                    null)
                {
                    continue;
                }

                if (obj.name ==
                    "CombinedServices.PortServicesLauncher")
                {
                    return obj;
                }
            }

            return null;
        }

        private void PrepareLauncher(
            DestinationButton launcher)
        {
            try
            {
                var field =
                    AccessTools.Field(
                        typeof(
                            DestinationButton
                        ),
                        "destinationLocalizedString"
                    );

                Behaviour behaviour =
                    field.GetValue(
                        launcher
                    )
                    as Behaviour;

                if (behaviour !=
                    null)
                {
                    behaviour.enabled =
                        false;
                }
            }
            catch
            {
            }

            try
            {
                var field =
                    AccessTools.Field(
                        typeof(
                            DestinationButton
                        ),
                        "questAttentionCallout"
                    );

                GameObject quest =
                    field.GetValue(
                        launcher
                    )
                    as GameObject;

                if (quest !=
                    null)
                {
                    quest.SetActive(
                        false
                    );
                }
            }
            catch
            {
            }

            ApplyCustomIcon(
                launcher
            );
        }

        private void ApplyCustomIcon(
            DestinationButton launcher)
        {
            if (launcher ==
                null)
            {
                return;
            }

            try
            {
                var field =
                    AccessTools.Field(
                        typeof(
                            DestinationButton
                        ),
                        "icon"
                    );

                object iconObject =
                    field.GetValue(
                        launcher
                    );

                if (iconObject ==
                    null)
                {
                    return;
                }

                Behaviour behaviour =
                    iconObject
                    as Behaviour;

                if (customIconSprite ==
                    null)
                {
                    if (behaviour !=
                        null)
                    {
                        behaviour.enabled =
                            false;
                    }

                    return;
                }

                var property =
                    AccessTools.Property(
                        iconObject.GetType(),
                        "sprite"
                    );

                if (property !=
                    null)
                {
                    property.SetValue(
                        iconObject,
                        customIconSprite,
                        null
                    );
                }

                if (behaviour !=
                    null)
                {
                    behaviour.enabled =
                        true;
                }
            }
            catch
            {
            }
        }

        private void AddLauncherForCleanup(
            DockUI dockUI,
            GameObject launcherObject)
        {
            try
            {
                var field =
                    AccessTools.Field(
