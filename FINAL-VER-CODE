    [HarmonyPatch(
        typeof(DestinationButton),
        "OnButtonClicked"
    )]
    public static class DestinationButtonClickPatch
    {
        [HarmonyPrefix]
        public static bool Prefix(
            DestinationButton __instance)
        {
            CombinedServicesBehaviour instance =
                CombinedServicesBehaviour
                    .Instance;

            if (instance ==
                null)
            {
                return true;
            }

            if (CombinedServicesBehaviour
                    .LauncherButton ==
                __instance)
            {
                instance
                    .OpenPortServices();

                return false;
            }

            // While our overlay is open, do not let a hidden
            // vanilla destination button receive a click.
            if (instance
                .ShouldBlockVanillaButtonClicks())
            {
                return false;
            }

            return true;
        }
    }

