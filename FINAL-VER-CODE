                            coverHeight +
                            10f,
                        coverWidth -
                            28f,
                        coverHeight -
                            20f
                    ),
                    currentUndockMessage,
                    undockMessageStyle
                );
            }
        }

        private string GetPortStatusText()
        {
            try
            {
                if (GameManager.Instance ==
                    null)
                {
                    return currentPortDisplayName;
                }

                float normalizedTime =
                    GameManager.Instance
                        .Time
                        .Time;

                int totalMinutes =
                    Mathf.FloorToInt(
                        normalizedTime *
                        24f *
                        60f
                    ) %
                    (24 * 60);

                int hour24 =
                    totalMinutes /
                    60;

                int minute =
                    totalMinutes %
                    60;

                int hour12 =
                    hour24 %
                    12;

                if (hour12 ==
                    0)
                {
                    hour12 =
                        12;
                }

                string suffix =
                    hour24 <
                            12
                        ? "AM"
                        : "PM";

                string timeText =
                    $"{hour12}:{minute:00} {suffix}";

                decimal funds =
                    GameManager.Instance
                        .SaveData
                        .Funds;

                int hullRemaining =
                    GameManager.Instance
                        .Player
                        .RemainingHealth;

                int hullMaximum =
                    GameManager.Instance
                        .PlayerStats
                        .DamageThreshold +
                    1;

                int cargoUsed;
                int cargoCapacity;

                GetCargoUsage(
                    out cargoUsed,
                    out cargoCapacity
                );

                int researchParts =
                    GameManager.Instance
                        .ResearchHelper
                        .TotalPartCount;

                return
                    $"{currentPortDisplayName}  |  {timeText}  |  ${funds:N0}  |  Hull {hullRemaining}/{hullMaximum}  |  Cargo {cargoUsed}/{cargoCapacity}  |  Research Parts {researchParts}";
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Port status failed: {ex.Message}"
                );

                return currentPortDisplayName;
            }
        }

        private void GetCargoUsage(
            out int used,
            out int capacity)
        {
            used =
                0;

            capacity =
                0;

            if (GameManager.Instance ==
                    null ||
                GameManager.Instance.SaveData ==
                    null ||
                GameManager.Instance.SaveData
                    .Inventory ==
                    null)
            {
                return;
            }

            GridCellData[,] cells =
                GameManager.Instance
                    .SaveData
                    .Inventory
                    .Grid;

            if (cells ==
                null)
            {
                return;
            }

            foreach (GridCellData cell
                     in cells)
            {
                if (cell ==
                        null ||
                    cell.IsHidden)
                {
                    continue;
                }

                capacity++;

                if (cell.ContainsObject)
                {
                    used++;
                }
            }
        }

