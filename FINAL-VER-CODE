        private string CleanName(
            string value)
        {
            if (string
                .IsNullOrWhiteSpace(
                    value))
            {
                return "Unknown";
            }

            string result =
                value;

            if (result.Contains(
                "."))
            {
                string[] sections =
                    result.Split(
                        '.'
                    );

                result =
                    sections[
                        sections.Length -
                        1
                    ];
            }

            result =
                result.Replace(
                    "_",
                    " "
                );

            result =
                result.Replace(
                    "-",
                    " "
                );

            return result;
        }

