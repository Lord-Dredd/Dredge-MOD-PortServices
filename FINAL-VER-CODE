        private void SkipFebucciText()
        {
            try
            {
                MonoBehaviour[]
                    behaviours =
                        UnityEngine.Object
                            .FindObjectsOfType<
                                MonoBehaviour
                            >();

                foreach (
                    MonoBehaviour behaviour
                    in behaviours)
                {
                    if (behaviour ==
                        null)
                    {
                        continue;
                    }

                    if (!behaviour
                        .isActiveAndEnabled)
                    {
                        continue;
                    }

                    Type type =
                        behaviour
                            .GetType();

                    string fullName =
                        type.FullName;

                    if (string
                        .IsNullOrEmpty(
                            fullName))
                    {
                        continue;
                    }

                    if (!fullName
                        .StartsWith(
                            "Febucci.",
                            StringComparison
                                .Ordinal))
                    {
                        continue;
                    }

                    MethodInfo method =
                        type.GetMethod(
                            "SkipTypewriter",
                            BindingFlags.Instance |
                            BindingFlags.Public |
                            BindingFlags.NonPublic,
                            null,
                            Type.EmptyTypes,
                            null
                        );

                    if (method ==
                        null)
                    {
                        continue;
                    }

                    try
                    {
                        method.Invoke(
                            behaviour,
                            null
                        );
                    }
                    catch
                    {
                    }
                }
            }
            catch
            {
            }
        }

