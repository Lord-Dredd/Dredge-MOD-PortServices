        private string GetCaptainsLogPath()
        {
            return Path.Combine(
                Environment.CurrentDirectory,
                "Mods",
                "dredd.combinedservices",
                "PortServices.stats"
            );
        }

        private void LoadCaptainsLog()
        {
            try
            {
                string path =
                    GetCaptainsLogPath();

                if (!File.Exists(
                    path))
                {
                    return;
                }

                serviceUseCounts.Clear();
                portVisitCounts.Clear();
                portDisplayNames.Clear();

                foreach (string line
                         in File.ReadAllLines(
                            path
                         ))
                {
                    if (string.IsNullOrWhiteSpace(
                        line))
                    {
                        continue;
                    }

                    string[] parts =
                        line.Split(
                            '|'
                        );

                    if (parts.Length <
                        2)
                    {
                        continue;
                    }

                    int value;

                    if (parts[0] ==
                            "TOTAL_PORT_VISITS" &&
                        int.TryParse(
                            parts[1],
                            out value))
                    {
                        totalPortVisits =
                            Mathf.Max(
                                0,
                                value
                            );
                    }
                    else if (parts[0] ==
                                "TOTAL_SLEEPS" &&
                             int.TryParse(
                                parts[1],
                                out value))
                    {
                        totalSleeps =
                            Mathf.Max(
                                0,
                                value
                            );
                    }
                    else if (parts[0] ==
                                "FISH_MARKET_TRIPS" &&
                             int.TryParse(
                                parts[1],
                                out value))
                    {
                        totalFishMarketTrips =
                            Mathf.Max(
                                0,
                                value
                            );
                    }
                    else if (parts[0] ==
                                "SLEEP_SPEED" &&
                             int.TryParse(
                                parts[1],
                                out value))
                    {
                        sleepSpeedIndex =
                            Mathf.Clamp(
                                value,
                                0,
                                sleepSpeedMultipliers
                                    .Length -
                                1
                            );
                    }
                    else if (parts[0] ==
                                "WAKE_HOUR" &&
                             int.TryParse(
                                parts[1],
                                out value))
                    {
                        wakeHourIndex =
                            Mathf.Clamp(
                                value,
                                0,
                                wakeHourOptions
                                    .Length -
                                1
                            );
                    }
                    else if (parts[0] ==
                                "SERVICE" &&
                             parts.Length >=
                                3 &&
                             int.TryParse(
                                parts[2],
                                out value))
                    {
                        string label =
                            Uri.UnescapeDataString(
                                parts[1]
                            );

                        serviceUseCounts[
                            label
                        ] =
                            Mathf.Max(
                                0,
                                value
                            );
                    }
                    else if (parts[0] ==
                                "PORT" &&
                             parts.Length >=
                                4 &&
                             int.TryParse(
                                parts[3],
                                out value))
                    {
                        string id =
                            Uri.UnescapeDataString(
                                parts[1]
                            );

                        string name =
                            Uri.UnescapeDataString(
                                parts[2]
                            );

                        portVisitCounts[
                            id
                        ] =
                            Mathf.Max(
                                0,
                                value
                            );

                        portDisplayNames[
                            id
                        ] =
                            name;
                    }
                }
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Captain's Log load failed: {ex.Message}"
                );
            }
        }

        private void SaveCaptainsLog()
        {
            try
            {
                string path =
                    GetCaptainsLogPath();

                string directory =
                    Path.GetDirectoryName(
                        path
                    );

                if (!string.IsNullOrEmpty(
                    directory))
                {
                    Directory.CreateDirectory(
                        directory
                    );
                }

                List<string> lines =
                    new List<string>();

                lines.Add(
                    "VERSION|1"
                );

                lines.Add(
                    $"TOTAL_PORT_VISITS|{totalPortVisits}"
                );

                lines.Add(
                    $"TOTAL_SLEEPS|{totalSleeps}"
                );

                lines.Add(
                    $"FISH_MARKET_TRIPS|{totalFishMarketTrips}"
                );

                lines.Add(
                    $"SLEEP_SPEED|{sleepSpeedIndex}"
                );

                lines.Add(
                    $"WAKE_HOUR|{wakeHourIndex}"
                );

                foreach (var pair
                         in serviceUseCounts)
                {
                    lines.Add(
                        $"SERVICE|{Uri.EscapeDataString(pair.Key)}|{pair.Value}"
                    );
                }

                foreach (var pair
                         in portVisitCounts)
                {
                    string name =
                        portDisplayNames
                            .ContainsKey(
                                pair.Key
                            )
                            ? portDisplayNames[
                                pair.Key
                            ]
                            : pair.Key;

                    lines.Add(
                        $"PORT|{Uri.EscapeDataString(pair.Key)}|{Uri.EscapeDataString(name)}|{pair.Value}"
                    );
                }

                File.WriteAllLines(
                    path,
                    lines.ToArray()
                );
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Captain's Log save failed: {ex.Message}"
                );
            }
        }

        private void ResetCaptainsLogStatistics()
        {
            totalPortVisits =
                0;

            totalSleeps =
                0;

            totalFishMarketTrips =
                0;

            serviceUseCounts.Clear();
            portVisitCounts.Clear();
            portDisplayNames.Clear();

            SaveCaptainsLog();

            Main.Log(
