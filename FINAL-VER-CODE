            }

            FindSleepButton();

            if (sleepButton ==
                null)
            {
                Main.Log(
                    "Sleep button clicked, but no RestDestination was found."
                );

                return;
            }

            PlayVanillaUISound(
                false
            );

            menuOpen =
                false;

            modRouteActive =
                true;

            sleepRouteActive =
                true;

            UnfreezeVanillaDockInput();

            StopSpeedEffects();

            if (routeWatcherCoroutine !=
                null)
            {
                StopCoroutine(
                    routeWatcherCoroutine
                );
            }

            BeginSpeedBoost(
                sleepSpeedMultipliers[
                    sleepSpeedIndex
                ]
            );

            try
            {
                MethodInfo method =
                    AccessTools.Method(
                        typeof(
                            SubDestinationButton
                        ),
                        "OnButtonClicked"
                    );

                if (method ==
                    null)
                {
                    throw new Exception(
                        "SubDestinationButton.OnButtonClicked not found."
                    );
                }

                Main.Log(
                    "Port Services: Sleep clicked."
                );

                method.Invoke(
                    sleepButton,
                    null
                );

                routeWatcherCoroutine =
                    StartCoroutine(
                        WatchForSleepReturn()
                    );
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Sleep failed: {ex}"
                );

                modRouteActive =
                    false;

                sleepRouteActive =
                    false;

                StopSpeedEffects();

                if (routeWatcherCoroutine !=
                    null)
                {
                    StopCoroutine(
                        routeWatcherCoroutine
                    );

                    routeWatcherCoroutine =
                        null;
                }

                OpenPortServicesOverlay();
            }
        }

        public void ApplyConfiguredWakeTime()
        {
            if (!sleepRouteActive ||
                GameManager.Instance ==
                    null ||
                GameManager.Instance.Time ==
                    null)
            {
                return;
            }

            try
            {
                TimeController timeController =
                    GameManager.Instance
                        .Time;

                float currentTime =
                    timeController.Time;

                float targetTime =
                    wakeHourOptions[
                        wakeHourIndex
                    ] /
                    24f;

                float timeRemaining =
                    targetTime -
                    currentTime;

                if (timeRemaining <=
                    0.0001f)
                {
                    timeRemaining +=
                        1f;
                }

                decimal remaining =
                    (decimal)timeRemaining;

                var remainingField =
                    AccessTools.Field(
                        typeof(TimeController),
                        "timeRemainingToForcefullyPass"
                    );

                var totalField =
                    AccessTools.Field(
                        typeof(TimeController),
                        "totalTimeToForcefullyPass"
                    );

                if (remainingField ==
                        null ||
                    totalField ==
                        null)
                {
                    throw new Exception(
                        "Sleep timing fields were not found."
                    );
                }

                remainingField.SetValue(
                    timeController,
                    remaining
                );

                totalField.SetValue(
                    timeController,
                    remaining
                );

                Main.Log(
                    $"Vanilla sleep target adjusted to {FormatWakeHour(wakeHourOptions[wakeHourIndex])}."
                );
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Wake-time adjustment failed: {ex.Message}"
                );
            }
        }

