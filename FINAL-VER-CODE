                modRouteActive =
                    false;

                StopSpeedEffects();

                if (routeWatcherCoroutine !=
                    null)
                {
                    StopCoroutine(
                        routeWatcherCoroutine
                    );

                    routeWatcherCoroutine =
                        null;
                }

                // Vanilla dock never went away,
                // so recovery is trivial.
                RefreshEntries();

                OpenPortServicesOverlay();
            }
        }

        // =========================================================
