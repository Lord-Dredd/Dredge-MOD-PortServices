        private void RecordPortVisit(
            Dock dock)
        {
            if (dock ==
                    null ||
                dock.Data ==
                    null)
            {
                return;
            }

            string id =
                !string.IsNullOrWhiteSpace(
                    dock.Data.Id)
                    ? dock.Data.Id
                    : dock.name;

            string name =
                GetDockDisplayName(
                    dock
                );

            totalPortVisits++;

            if (!portVisitCounts.ContainsKey(
                id))
            {
                portVisitCounts[
                    id
                ] =
                    0;
            }

            portVisitCounts[
                id
            ]++;

            portDisplayNames[
                id
            ] =
                name;

            SaveCaptainsLog();
        }

        private void RecordServiceUse(
            string label,
            bool fishMarket)
        {
            if (string.IsNullOrWhiteSpace(
                label))
            {
                label =
                    "Unknown Service";
            }

            if (!serviceUseCounts.ContainsKey(
                label))
            {
                serviceUseCounts[
                    label
                ] =
                    0;
            }

            serviceUseCounts[
                label
            ]++;

            if (fishMarket)
            {
                totalFishMarketTrips++;
            }

            SaveCaptainsLog();
        }

        private void RecordCompletedSleep()
        {
            totalSleeps++;

            RecordServiceUse(
                "Sleep",
                false
            );
        }

        private string GetMostUsedService()
        {
            if (serviceUseCounts.Count ==
                0)
            {
                return "None yet";
            }

            return serviceUseCounts
                .OrderByDescending(
                    pair =>
                        pair.Value
                )
                .ThenBy(
                    pair =>
                        pair.Key
                )
                .First()
                .Key;
        }

        private string GetFavoritePort()
        {
            if (portVisitCounts.Count ==
                0)
            {
                return "None yet";
            }

            string id =
                portVisitCounts
                    .OrderByDescending(
                        pair =>
                            pair.Value
                    )
                    .ThenBy(
                        pair =>
                            pair.Key
                    )
                    .First()
                    .Key;

            return portDisplayNames
                .ContainsKey(
                    id
                )
                ? portDisplayNames[
                    id
                ]
                : CleanName(
                    id
                );
        }

