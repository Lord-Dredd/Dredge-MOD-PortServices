        private IEnumerator WatchForSleepReturn()
        {
            bool sleepStarted =
                false;

            float startDeadline =
                Time.unscaledTime +
                1.5f;

            // Wait for DREDGE's real forced-time sleep process.
            while (PlayerIsDocked() &&
                   Time.unscaledTime <
                    startDeadline)
            {
                TimeController timeController =
                    GameManager.Instance !=
                            null
                        ? GameManager.Instance
                            .Time
                        : null;

                if (timeController !=
                        null &&
                    timeController
                        .IsTimePassingForcefully() &&
                    timeController
                        .CurrentTimePassageMode ==
                            TimePassageMode.SLEEP)
                {
                    sleepStarted =
                        true;

                    break;
                }

                yield return null;
            }

            if (!sleepStarted)
            {
                Main.Log(
                    "Fast sleep did not start. Recovering Port Services."
                );

                sleepRouteActive =
                    false;

                StopSpeedEffects();

                yield return
                    new WaitForSecondsRealtime(
                        0.10f
                    );

                ReturnToPortServices();

                routeWatcherCoroutine =
                    null;

                yield break;
            }

            Main.Log(
                $"Sleep started at {sleepSpeedMultipliers[sleepSpeedIndex]:0}x speed, waking at {FormatWakeHour(wakeHourOptions[wakeHourIndex])}."
            );

            RecordCompletedSleep();

            // Keep the boost active until DREDGE reports that its
            // forced sleep-time passage has completely finished.
            while (PlayerIsDocked())
            {
                TimeController timeController =
                    GameManager.Instance !=
                            null
                        ? GameManager.Instance
                            .Time
                        : null;

                if (timeController ==
                        null ||
                    !timeController
                        .IsTimePassingForcefully())
                {
                    break;
                }

                yield return null;
            }

            EndSpeedBoost();

            // HideCurrentDestination asks DockUI to rebuild after a
            // vanilla 0.2 second delay. Do not harvest its lists until
            // that rebuild has actually completed.
            float dockReadyDeadline =
                Time.unscaledTime +
                1.5f;

            while (PlayerIsDocked() &&
                   !DockUiFinishedRebuilding() &&
                   Time.unscaledTime <
                    dockReadyDeadline)
            {
                currentDockUI =
                    GameManager.Instance
                        .UI
                        .DockUI;

                yield return null;
            }

            // Let all newly-created buttons finish OnEnable before
            // RefreshEntries captures their live references.
            yield return
                new WaitForEndOfFrame();

            yield return
                new WaitForEndOfFrame();

            if (!DockUiFinishedRebuilding())
            {
                Main.Log(
                    "Dock rebuild wait timed out; refreshing available buttons anyway."
                );
            }

            sleepRouteActive =
                false;

            if (modRouteActive &&
                PlayerIsDocked())
            {
                ReturnToPortServices();
            }

            routeWatcherCoroutine =
                null;
        }

        private IEnumerator WatchForVanillaReturn()
        {
            yield return null;
            yield return null;

            bool interactionStarted =
                false;

            float startDeadline =
                Time.unscaledTime +
                2.5f;

            // =====================================================
            // WAIT FOR STORE/DIALOGUE TO OPEN
            // =====================================================

            while (PlayerIsDocked())
            {
                bool dockShowing =
                    DockWindowShowing();

                bool dialogueShowing =
                    DialogueShowing();

                if (!dockShowing ||
                    dialogueShowing)
                {
                    interactionStarted =
                        true;

                    break;
                }

                if (Time.unscaledTime >=
                    startDeadline)
                {
                    break;
                }

                yield return null;
            }

            // If vanilla never visibly opened anything,
            // recover our menu instead of getting stuck.
            if (!interactionStarted)
            {
                Main.Log(
                    "Interaction did not enter a detectable state. Recovering Port Services."
                );

                yield return
                    new WaitForSecondsRealtime(
                        0.15f
                    );

                ReturnToPortServices();

                routeWatcherCoroutine =
                    null;

                yield break;
            }

            // =====================================================
            // WAIT FOR VANILLA TO RETURN TO DOCK
            // =====================================================

            while (PlayerIsDocked())
            {
                bool dockShowing =
                    DockWindowShowing();

                bool dialogueShowing =
                    DialogueShowing();

                if (dockShowing &&
                    !dialogueShowing)
                {
                    break;
                }

                yield return null;
            }

            if (!modRouteActive)
            {
                routeWatcherCoroutine =
                    null;

                yield break;
            }

            StartSpeedPulse(
                EXIT_SPEED_TIME
            );

            yield return
                new WaitForSecondsRealtime(
                    EXIT_SPEED_TIME
                );

            yield return
                new WaitForEndOfFrame();

            ReturnToPortServices();

            routeWatcherCoroutine =
                null;
        }

