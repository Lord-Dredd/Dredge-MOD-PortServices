            harmony.PatchAll();

            GameObject obj =
                new GameObject(
                    "CombinedServicesBehaviour"
                );

            UnityEngine.Object
                .DontDestroyOnLoad(
                    obj
                );

            obj.AddComponent<
                CombinedServicesBehaviour
            >();

            Log(
                "Port Services initialized."
            );
        }

        public static void Log(
            string message)
        {
            try
            {
                string logPath =
                    Path.Combine(
                        Environment.CurrentDirectory,
                        "Logs",
                        "CombinedServices.log"
                    );

                File.AppendAllText(
                    logPath,
                    $"[{DateTime.Now:HH:mm:ss}] {message}{Environment.NewLine}"
                );
            }
            catch
            {
            }
        }
    }

