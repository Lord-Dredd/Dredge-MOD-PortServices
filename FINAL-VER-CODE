        private string GetDockDisplayName(
            Dock dock)
        {
            if (dock ==
                    null ||
                dock.Data ==
                    null)
            {
                return "Unknown Port";
            }

            try
            {
                object dockData =
                    dock.Data;

                var dockNameProperty =
                    AccessTools.Property(
                        dockData.GetType(),
                        "DockNameKey"
                    );

                object localizedString =
                    dockNameProperty !=
                            null
                        ? dockNameProperty
                            .GetValue(
                                dockData,
                                null
                            )
                        : null;

                var localizedStringMethod =
                    localizedString !=
                            null
                        ? AccessTools.Method(
                            localizedString
                                .GetType(),
                            "GetLocalizedString",
                            Type.EmptyTypes
                        )
                        : null;

                string dockName =
                    localizedStringMethod !=
                            null
                        ? localizedStringMethod
                            .Invoke(
                                localizedString,
                                null
                            ) as string
                        : null;

                if (!string.IsNullOrWhiteSpace(
                    dockName))
                {
                    return dockName;
                }
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Dock name localization failed: {ex.Message}"
                );
            }

            if (!string.IsNullOrWhiteSpace(
                dock.Data.Id))
            {
                return CleanName(
                    dock.Data.Id
                );
            }

            return "Unknown Port";
        }

        private void ChooseUndockMessage()
        {
            if (undockMessages ==
                    null ||
                undockMessages.Length ==
                    0)
            {
                currentUndockMessage =
                    string.Empty;

                return;
            }

            int index =
                UnityEngine.Random.Range(
                    0,
                    undockMessages.Length
                );

            if (undockMessages.Length >
                    1 &&
                index ==
                    lastUndockMessageIndex)
            {
                index =
                    (index +
                    UnityEngine.Random.Range(
                        1,
                        undockMessages.Length
                    )) %
                    undockMessages.Length;
            }

            lastUndockMessageIndex =
                index;

            currentUndockMessage =
                undockMessages[
                    index
                ];
        }

