    [HarmonyPatch(
        typeof(DockUI),
        nameof(DockUI.Leave)
    )]
    public static class DockUILeavePatch
    {
        [HarmonyPrefix]
        public static bool Prefix()
        {
            CombinedServicesBehaviour instance =
                CombinedServicesBehaviour
                    .Instance;

            if (instance ==
                null)
            {
                return true;
            }

            if (instance
                .ShouldBlockUndock())
            {
                Main.Log(
                    "DockUI.Leave blocked while Port Services was open."
                );

                return false;
            }

            instance
                .ResetForNextDock();

            return true;
        }
    }
