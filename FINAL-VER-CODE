            if (undockCoverTexture ==
                null)
            {
                return;
            }

            float coverWidth =
                Mathf.Clamp(
                    Screen.width *
                    0.20f,
                    280f,
                    380f
                );

            float coverHeight =
                Mathf.Clamp(
                    Screen.height *
                    0.12f,
                    90f,
                    130f
