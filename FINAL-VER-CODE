        private bool DockUiFinishedRebuilding()
        {
            if (currentDockUI ==
                    null ||
                !DockWindowShowing())
            {
                return false;
            }

            try
            {
                var pendingField =
                    AccessTools.Field(
                        typeof(DockUI),
                        "isShowPending"
                    );

                if (pendingField !=
                        null &&
                    (bool)pendingField
                        .GetValue(
                            currentDockUI
                        ))
                {
                    return false;
                }

                var objectsField =
                    AccessTools.Field(
                        typeof(DockUI),
                        "destinationButtonObjects"
                    );

                List<GameObject> objects =
                    objectsField !=
                            null
                        ? objectsField
                            .GetValue(
                                currentDockUI
                            ) as List<GameObject>
                        : null;

                if (objects ==
                    null)
                {
                    return false;
                }

                foreach (GameObject obj
                         in objects)
                {
                    if (obj ==
                            null ||
                        !obj.activeInHierarchy)
                    {
                        continue;
                    }

                    if (obj.name ==
                        "CombinedServices.PortServicesLauncher")
                    {
                        continue;
                    }

                    return true;
                }
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Dock rebuild check failed: {ex.Message}"
                );
            }

            return false;
        }

        private void FreezeVanillaDockInput()
        {
            frozenDockBehaviours.Clear();

            if (currentDockUI ==
                null)
            {
                return;
            }

            try
            {
                Behaviour[] behaviours =
                    currentDockUI
                        .GetComponentsInChildren<
                            Behaviour
                        >(true);

                foreach (Behaviour behaviour
                         in behaviours)
                {
                    if (behaviour ==
                        null)
                    {
                        continue;
                    }

                    if (behaviour ==
                        currentDockUI)
                    {
                        continue;
                    }

                    if (!behaviour.enabled)
                    {
                        continue;
                    }

                    behaviour.enabled =
                        false;

                    frozenDockBehaviours.Add(
                        behaviour
                    );
                }

                Main.Log(
                    $"Port Services input shield enabled. Disabled {frozenDockBehaviours.Count} vanilla UI behaviours."
                );
            }
            catch (Exception ex)
            {
                Main.Log(
                    $"Port Services input shield failed: {ex.Message}"
                );
            }
        }

        private void UnfreezeVanillaDockInput()
        {
            foreach (Behaviour behaviour
                     in frozenDockBehaviours)
            {
                if (behaviour ==
                    null)
                {
                    continue;
                }

                try
                {
                    behaviour.enabled =
                        true;
                }
                catch
                {
                }
            }

            frozenDockBehaviours.Clear();

            Main.Log(
                "Port Services input shield disabled."
            );
        }

