        private void CheckForgeSequence()
        {
            if (!Input.anyKeyDown)
            {
                return;
            }

            KeyCode expected =
                forgeSequence[
                    forgePosition
                ];

            if (Input.GetKeyDown(
                expected))
            {
                forgePosition++;

                if (forgePosition >=
                    forgeSequence.Length)
                {
                    forgePosition =
                        0;

                    showForgeMessage =
                        true;

                    forgeMessageUntil =
                        Time.unscaledTime +
                        4f;

                    Main.Log(
                        "FORGE WAS HERE."
                    );
                }

                return;
            }

            if (Input.GetMouseButtonDown(
                    0) ||
                Input.GetMouseButtonDown(
                    1) ||
                Input.GetMouseButtonDown(
                    2))
            {
                return;
            }

            forgePosition =
                0;
        }

